    "privacy.backgroundDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On iPhone and iPad, terminal input pauses and unfinished file transfers are cancelled in the background. The connection is checked before input resumes. Reconnect manually if it is no longer available. Use tmux to preserve remote work."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone/iPad 进入后台后暂停终端输入并取消未完成的文件传输。返回时先检查连接，再恢复输入；连接失效时由你手动重连。建议使用 tmux 保留远程任务。"
          }
        }
      }
    },
    "privacy.cloud" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional iCloud sync"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选 iCloud 同步"
          }
        }
      }
    },
    "privacy.cloudDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is off by default. When enabled, only nonsecret host settings, groups, and tags are copied to your private iCloud database. Credentials, host trust, sessions, terminal content, and device preferences are excluded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步默认关闭。启用后，仅将非机密主机配置、分组和标签同步到你的 iCloud 私有库；凭据、主机信任、会话、终端内容和设备偏好不上传。"
          }
        }
      }
    },
