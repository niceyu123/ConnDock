    },
    "cloud.error.invalidRecord" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cloud configuration is invalid or uses an unsupported version. Local data was not overwritten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云端配置格式无效或版本不受支持，未覆盖本地数据。"
          }
        }
      }
    },
    "cloud.error.localStore" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to save sync state. Please retry."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存同步状态，请重试。"
          }
        }
      }
    },
    "cloud.error.network" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is temporarily unreachable. Sync will retry automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法连接 iCloud，将自动重试。"
          }
        }
      }
    },
    "cloud.error.quota" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud storage is full. Free space and retry."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 存储空间不足，请释放空间后重试。"
