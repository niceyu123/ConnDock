    "cloud.configurationRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This build does not have CloudKit signing enabled. All local features remain available. Use a Debug or Release build configured for iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此构建尚未启用 CloudKit 签名权限。可继续使用全部本地功能；请使用已配置 iCloud 的 Debug 或 Release 构建。"
          }
        }
      }
    },
    "cloud.conflictPolicy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conflicts select one complete configuration by logical version. Deletion takes priority over offline edits."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一配置发生冲突时按逻辑版本选择一份完整记录；删除优先于离线编辑。"
          }
        }
      }
    },
    "cloud.copyDeleted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud copy deleted. Local configurations preserved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云端副本已删除，本地配置已保留。"
          }
        }
      }
    },
    "cloud.credentialsExcluded" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords and private keys stay in this device’s Keychain. Enter them again on other devices."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码和私钥仅保存在本机 Keychain；其他设备需要重新输入。"
          }
        }
      }
    },
    "cloud.deleteConfirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete Cloud Copy"
          }
