    "sshConfig.error.read" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not read the selected configuration. Choose an accessible regular UTF-8 text file."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取所选配置文件。请选择可访问的普通 UTF-8 文本文件。"
          }
        }
      }
    },
    "sshConfig.error.limit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configuration exceeds the import limits: 256 KiB, 8192 lines, 8192 bytes per line, and 256 hosts. This file was not imported."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置超出导入限制：最多 256 KiB、8192 行、每行 8192 字节、256 个主机。未导入此文件。"
          }
        }
      }
    },
    "sshConfig.error.encoding" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configuration must be UTF-8 text without control characters."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置必须为 UTF-8 文本，且不能包含控制字符。"
          }
        }
      }
    },
    "sshConfig.error.cancelled" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import stopped. Saved hosts are retained; the remaining entries were not saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入已停止。已保存的主机仍然保留，其余条目未保存。"
          }
        }
      }
    },
    "sshConfig.issue.syntax" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invalid syntax prevents reliable scope detection. Import of this file is blocked."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置存在无效语法，无法可靠确定作用范围；已阻止此文件导入。"
          }
        }
      }
    },
    "sshConfig.issue.context" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include and Match can change the scope of later options and are not supported. Import of this file is blocked. No other files are read and no conditional commands are executed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持 Include 或 Match，它们可能改变后续配置的作用范围；已阻止此文件导入。不会读取其他文件或执行条件命令。"
          }
        }
      }
    },
    "sshConfig.issue.unsupported" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This connection uses an unsupported option and cannot be imported. Prepare a configuration containing only Host, HostName, User, Port, and optional IdentityFile directives."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此连接使用未支持的选项，已阻止导入。请准备仅含 Host、HostName、User、Port 和可选 IdentityFile 的配置。"
          }
        }
      }
    },
    "sshConfig.issue.hostname" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hostname is invalid or requires unsupported token expansion. Import is blocked."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机地址无效或需要尚未支持的变量展开，已阻止导入。"
          }
        }
      }
    },
    "sshConfig.issue.username" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The username is missing, invalid, or requires token expansion. Enter a default username or correct the User directive in the file."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户名缺失、无效或需要变量展开。请补充默认用户名，或修正文件中的 User。"
          }
        }
      }
    },
    "sshConfig.issue.port" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port must be a decimal integer from 1 to 65535. Import is blocked."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端口必须为 1–65535 的十进制整数，已阻止导入。"
          }
        }
      }
    },
    "sshConfig.issue.identityFile" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IdentityFile has an empty value. Import is blocked. Private key paths are never read or saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IdentityFile 的值为空，已阻止导入。不会读取或保存私钥路径。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
