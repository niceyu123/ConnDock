    "cloud.deleteCopy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete iCloud Copy…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 iCloud 配置副本…"
          }
        }
      }
    },
    "cloud.deleteDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete only this app’s cloud configurations for the current Apple ID and turn off sync on this device. Local configurations remain. Other synced devices pause; enabling again uploads their retained configurations."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅删除当前 Apple ID 中本应用的云端配置并关闭本机同步。本地配置保留。其他已同步的设备将暂停同步；再次启用会重新上传该设备保留的配置。"
          }
        }
      }
    },
    "cloud.deleteTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete the configuration copy in iCloud?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 iCloud 中的配置副本？"
          }
        }
      }
    },
    "cloud.enable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync host configurations"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步主机配置"
          }
        }
      }
    },
    "cloud.enableConfirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable Sync"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用同步"
          }
        }
      }
    },
    "cloud.enableDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host names, addresses, usernames, notes, groups, and tags are encrypted in the current Apple ID’s private CloudKit database and merged with other enabled devices. Passwords, private keys, and host trust decisions are excluded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机名称、地址、用户名、备注、分组和标签将加密保存到当前 Apple ID 的 CloudKit 私有数据库，并与其他已启用的设备合并。不会上传密码、私钥或主机信任决定。"
          }
        }
      }
    },
    "cloud.enableTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable iCloud configuration sync?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用 iCloud 配置同步？"
          }
        }
      }
    },
    "cloud.error.accountChanged" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Apple ID changed. Sync is off. Review the scope before enabling again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ID 已变化，同步已关闭。确认范围后可重新启用。"
          }
        }
      }
    },
    "cloud.error.cancelled" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sync was cancelled. Local configurations remain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本次同步已取消，本地配置保留。"
          }
        }
      }
    },
    "cloud.error.configuration" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud signing or container configuration is unavailable."
