      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurations remain on this device. Edit offline and retry automatically in the foreground when the network returns. Turning sync off preserves local data."
