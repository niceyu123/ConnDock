    "sshConfig.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preview and select connections to add. Imports explicit Host aliases, addresses, ports, and usernames from this file. Existing hosts are skipped and no connection is started."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预览并勾选要添加的连接。仅导入当前文件中的明确 Host 别名、地址、端口和用户名；不覆盖已有主机，不自动连接。"
          }
        }
      }
    },
    "sshConfig.credentialsDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credentials are not imported. IdentityFile is only a hint to use key authentication; private keys are never read and their paths are not saved. Edit each imported host to choose its credentials separately."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凭据不会导入。IdentityFile 仅作为密钥认证提示；不会读取私钥或保存其路径。导入后请编辑主机，单独选择凭据。"
          }
        }
      }
    },
    "sshConfig.defaultUsername" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Username for entries without User"
          }
