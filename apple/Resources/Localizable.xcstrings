    },
    "privacy.directDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH and SFTP connect directly to the servers you choose. The app has no account service or cloud relay, sends no app telemetry, and does not record terminal sessions by default. Apple’s settings govern system diagnostics."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 和 SFTP 直接连接你指定的服务器。应用不提供账号、云端中转或自行发送的遥测，也不默认录制终端。系统诊断按 Apple 的设置管理。"
          }
        }
      }
    },
    "privacy.filesDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SFTP downloads are first saved in the app cache. Clearing a transfer removes its temporary copy. Files you export are managed by you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SFTP 下载先保存在应用缓存中，清除传输任务时会删除对应临时副本。你主动导出的文件由你管理。"
          }
        }
      }
    },
    "privacy.local" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On this device"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机存储"
          }
        }
      }
    },
    "privacy.localDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts, groups, and tags are stored locally. Passwords and private keys are saved in this device’s Keychain only when you choose, never in the regular database or exported through MCP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机、分组和标签保存在本机。密码和私钥按你的选择存入本机 Keychain，不写入普通数据库，也不通过 MCP 导出。"
          }
        }
      }
    },
    "privacy.mcpDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP on Mac is off by default. External AI clients can access only information you authorize. Every arbitrary command needs one-time approval on Mac, and results are returned to the requester. Call history keeps metadata and command hashes only."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 的 MCP 默认关闭。外部 AI 客户端只可访问你授权的信息；每条任意命令都需在 Mac 单次批准，结果会返回给请求方。调用记录只保留元数据和命令摘要。"
          }
        }
      }
    },
    "privacy.telemetry" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App telemetry"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
