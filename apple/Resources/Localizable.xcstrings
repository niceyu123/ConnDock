    "privacy.trustDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first connection requires host fingerprint approval. A changed trusted key blocks the connection. Host trust stays on this device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次连接需确认主机指纹。已信任的密钥改变后会阻断连接；主机信任只在本机保存。"
          }
        }
      }
    },
